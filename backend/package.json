{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "node scripts/deploy-migrations.mjs",
        "db:url": "node scripts/print-db-url.mjs",
        "db:check": "node scripts/deploy-migrations.mjs --check",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "storage:check": "tsx scripts/check-storage.ts",
    "storage:describe": "tsx scripts/describe-store.ts",
    "db:check-transactions": "tsx scripts/check-transactions.ts",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1152.0",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^18.0.4",
        "express": "^5.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.0",
        "pg": "^8.23.1",
        "uuid": "^9.0.1",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^20.19.43",
        "@types/pg": "^8.23.1",
        "@types/uuid": "^9.0.8",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
}
