# Copy to backend/.env for local development: `cp .env.example backend/.env`

# PostgreSQL connection string.
# Locally: docker compose up -d   (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventinvites?schema=public"

# Generate with: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-long-random-string"
REFRESH_SECRET="replace-me-with-a-different-long-random-string"

PORT=4000
NODE_ENV="development"

# Leave empty locally. Set to your Vercel domain in production so CORS is
# explicit if the API and frontend are ever hosted separately.
FRONTEND_URL=""

# Required in production. Without it, uploads fall back to local disk, which
# Vercel's ephemeral filesystem discards.
BLOB_READ_WRITE_TOKEN=""

# Only needed when the frontend is hosted on a different origin than the API.
# VITE_API_BASE="/api"

# Push notifications for the Android app. A Firebase service-account key, as
# raw JSON or base64. Unset, push is a no-op and the web app is unchanged.
# FCM_SERVICE_ACCOUNT_JSON=""
# FCM_PROJECT_ID=""