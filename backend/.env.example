# Copy to backend/.env for local development: `cp .env.example backend/.env`

# PostgreSQL connection string.
# Locally: docker compose up -d   (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventinvites?schema=public"

# Generate with: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-long-random-string"
REFRESH_SECRET="replace-me-with-a-different-long-random-string"

PORT=4000
NODE_ENV="development"

# The API origin (for the web app, usually unset — pages and API share one
# origin). Add https://localhost for the APK's WebView so the Bearer-header
# CORS preflight is allowed, e.g. FRONTEND_URL="https://your-app.vercel.app,https://localhost"
# Locally this is empty: single-origin, no CORS.
FRONTEND_URL=""

# The uploads. On the Cloudflare Worker and in production the object store
# holds them; a local disk only works for development.
#   AWS_ENDPOINT_URL_S3="https://<branch>.storage.c-<cell>.<region>.aws.neon.tech"
#   AWS_ACCESS_KEY_ID=""
#   AWS_SECRET_ACCESS_KEY=""
#   AWS_REGION="ap-southeast-1"
#   NEON_STORAGE_BUCKET="eventinvites-storage"
#   NEON_STORAGE_ACCESS="private"

# Only needed when the frontend is hosted on a different origin than the API.
# VITE_API_BASE="/api"

# Push notifications for the Android app. A Firebase service-account key, as
# raw JSON or base64. Unset, push is a no-op and the web app is unchanged.
# FCM_SERVICE_ACCOUNT_JSON=""
# FCM_PROJECT_ID=""