{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name decides the public URL: <name>.<account>.workers.dev
  "name": "eventinvites",
  "main": "worker/index.ts",
  // From 2026-08-04 Workers enables nodejs_compat_v2, whose CommonJS interop
  // the AWS SDK and Express both need, and which gives a bundle a real
  // import.meta.url for the generated Prisma client to resolve its own
  // directory from.
  "compatibility_date": "2026-08-04",
  // Node's APIs, which the Express application, the `pg` driver and the
  // `node:http` bridge all need.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The single-page app, built from the same sources as the Android app.
    "directory": "./web/dist",
    "binding": "ASSETS",
    // A deep link such as /events/key/abc is answered with the app rather
    // than with a 404, because the router lives in the browser.
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker. Everything else is served from the
    // asset cache, where requests are free.
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "vars": {
    // The Worker is a deployed environment. It has no .env file to read, so
    // this is how the app learns where it is running.
    "NODE_ENV": "production",
    "APP_RUNTIME": "workers"
  },
  "define": {
    // The generated Prisma client resolves its own directory from
    // import.meta.url. A bundle has no file URL of its own, so one is given
    // here; the client only uses it to find the query compiler beside it,
    // and the bundler puts that beside it in the bundle.
    "import.meta.url": "\"file:///\""
  },
  "alias": {
    // The Workers runtime only allows WebAssembly it was given as a module,
    // not WebAssembly compiled while a request runs, so the Worker needs the
    // other of the two generated Prisma clients. Every module in the API
    // imports the client under the same path, so one entry switches all of
    // them. Node keeps the client that carries the query compiler as bytes,
    // which is what it can compile.
    //
    // The target is resolved from the project root, and names the file
    // outright so that the resolver finds it.
    "../generated/prisma/client": "./backend/src/generated/prisma-workers/client.ts"
  },
  // Cloudflare's pooled connection to the database. The identifier is a
  // resource id and belongs in the repository; the local connection string
  // holds a password and does not, so it is left out and the local run uses
  // the DATABASE_URL in .dev.vars instead.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_THE_ID_FROM_WRANGLER_HYPERDRIVE_CREATE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
