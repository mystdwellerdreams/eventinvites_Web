{
    "name": "event-invites",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "backend"
    ],
    "scripts": {
        "dev": "next dev",
        "build": "npm run db:generate && npm run web:build",
        "build:next": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "dev:backend": "npm run dev --workspace=backend",
        "start:backend": "npm run start --workspace=backend",
        "db:generate": "npm run db:generate --workspace=backend",
        "db:deploy": "npm run db:deploy --workspace=backend",
        "db:url": "npm run db:url --workspace=backend",
        "db:check": "npm run db:check --workspace=backend",
        "db:migrate": "npm run db:migrate --workspace=backend",
        "db:seed": "npm run db:seed --workspace=backend",
        "db:studio": "npm run db:studio --workspace=backend",
        "app:dev": "vite --config mobile/vite.config.ts --host",
        "app:build": "vite build --config mobile/vite.config.ts",
        "app:sync": "npm run app:build && cap sync android",
        "android:sync": "cap sync android",
        "android:assets": "node mobile/scripts/generate-assets.mjs",
        "android:copy": "cap copy android",
        "android:open": "cap open android",
        "android:run": "cap run android",
        "android:build": "cap build android",
        "web:build": "vite build --config web/vite.config.ts",
        "web:preview": "node scripts/serve-web-dist.mjs",
        "web:check": "node scripts/check-pages-routing.mjs",
        "check:uploads": "node scripts/check-image-uploads.mjs",
        "android:apk": "cd android && ./gradlew assembleRelease",
        "worker:dev": "node scripts/worker-dev.mjs",
        "worker:deploy": "wrangler deploy",
        "worker:typecheck": "tsc --noEmit -p worker/tsconfig.json",
        "worker:check": "node scripts/check-worker.mjs",
        "cf:dev-vars": "node scripts/write-dev-vars.mjs",
        "cf:hyperdrive-id": "node scripts/write-hyperdrive-id.mjs",
        "deploy:cloudflare": "npm run db:deploy && npm run cf:hyperdrive-id && npm run worker:deploy"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/app": "^8.1.2",
        "@capacitor/core": "^8.5.3",
        "@capacitor/local-notifications": "^8.3.1",
        "@capacitor/push-notifications": "^8.1.3",
        "axios": "^1.7.9",
        "next": "16.3.8",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.3",
        "@cloudflare/workers-types": "^5.20261019.1",
        "@types/node": "^20.19.43",
        "@types/react": "^18.2.55",
        "@types/react-dom": "^18.2.19",
        "@vitejs/plugin-react": "^5.2.0",
        "capacitor-secure-storage-plugin": "^0.13.0",
        "prisma": "^7.10.1",
        "react-router-dom": "^7.18.4",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "wrangler": "^4.151.2",
        "ws": "^8.22.0"
    },
    "engines": {
        "node": ">=22"
    }
}
