# Environment for the Vercel deployment
#
# Do not create a .env file here. Set these in
# Vercel -> Project -> Settings -> Environment Variables,
# for BOTH Production and Preview: the build command applies database
# migrations, so preview builds need them too.

# Required. PostgreSQL connection string, ending ?schema=public
#   Neon: run `npm run db:url` in the source checkout to print it.
#   It must start with postgresql:// — not https://, and not a
#   *.vercel.app domain. Strip any surrounding quotes.
DATABASE_URL=""

# Required. Generate each with: openssl rand -base64 32
JWT_SECRET=""
REFRESH_SECRET=""

# Required. From Storage -> Blob in the Vercel project. Without it every
# uploaded avatar and cover image is lost on the next cold start.
BLOB_READ_WRITE_TOKEN=""

# Object storage - Neon Object Storage (S3-compatible). Set these on the API's
# environment and the uploads live in the bucket that is scoped to the same
# Neon branch as the database. The bucket is reached with the AWS SDK's own
# variable names, so the same code path serves any S3-compatible store.
#
# Create the bucket with:
#   neon buckets create eventinvites-storage --access-level private
# and generate the key pair from Neon -> Storage -> Object Storage -> Keys.
#   AWS_ENDPOINT_URL_S3="https://<branch>.storage.c-<cell>.<region>.aws.neon.tech"
#   AWS_ACCESS_KEY_ID=""
#   AWS_SECRET_ACCESS_KEY=""
#   AWS_REGION="ap-southeast-1"
#   NEON_STORAGE_BUCKET="eventinvites-storage"
# The bucket's access level is a property of the bucket, not of the request,
# so it is stated here rather than probed: a public bucket answers the browser
# itself, a private one is read with these credentials and served by the API.
#   NEON_STORAGE_ACCESS="private"
#
# STORAGE_BACKEND picks the store when more than one is configured; without it
# the first configured store wins (S3, then Vercel Blob, then a local disk).
#   STORAGE_BACKEND="s3"
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
NEON_STORAGE_BUCKET=""
NEON_STORAGE_ACCESS=""

# Required. The Cloudflare Turnstile key pair, from the Cloudflare
# dashboard -> Turnstile -> Add site. The SECRET stays server-side; the
# SITE key is inlined into the browser bundle by Next.js.
#   Secret: https://dash.cloudflare.com -> Turnstile -> <site> -> Secret Key
#   Site:   https://dash.cloudflare.com -> Turnstile -> <site> -> Site Key
# A challenge is asked for when signing in or registering, when an event is
# created or deleted, and when feedback is sent through the form.
# Leave both unset for local development: the check then accepts anything,
# and the app falls back to its own arithmetic challenge for the widget.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Optional. Signs the fallback challenge's tokens; defaults to JWT_SECRET.
CAPTCHA_SECRET=""

# FRONTEND_URL — comma-separated origins allowed to call the API. Include
# the APK's WebView origin (https://localhost) so the Bearer-header preflight
# is accepted: e.g. https://your-app.vercel.app,https://localhost
# Leave unset only if the API and frontend share an origin and there is no APK.
FRONTEND_URL=""

# Push notifications for the Android app.
#
# The service-account key from Firebase -> Project settings -> Service
# accounts -> Generate new private key, as the raw JSON or its base64 copy.
# Leave it unset and nothing is pushed: the web app and the API behave exactly
# as they do today. Set it (on the API's environment, not the frontend's) and
# every notification written by the app is also delivered to the signed-in
# user's registered devices.
#   FCM_SERVICE_ACCOUNT_JSON=""
# Optional, only when the key belongs to more than one Firebase project:
#   FCM_PROJECT_ID=""

# Not Vercel variables: read at APK build/sync time.
#
# CAPACITOR_DEV=1           — set this to make the shell load a dev server
#                            (default: off, so the release build loads mobile/www/)
# CAPACITOR_SERVER_URL      — the dev server URL when CAPACITOR_DEV=1
#                            (default: http://10.0.2.2:5173)
# VITE_API_BASE             — the absolute API URL baked into the Vite bundle,
#                            e.g. https://your-app.vercel.app/api. Required
#                            for `npm run app:build` to produce a working APK.
#   CAPACITOR_DEV=1
#   CAPACITOR_SERVER_URL=http://10.0.2.2:5173
#   VITE_API_BASE=https://your-app.vercel.app/api