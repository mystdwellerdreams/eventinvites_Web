# Environment for the deployed API
#
# The Cloudflare Worker reads these as secrets:
#   npx wrangler secret put <NAME>
# The Vercel deployment reads them from the project's environment variables.
# Locally they live in .env.local, which is excluded from every deploy.
#
# Every value below is also read by the local development server and by the
# `wrangler dev` Worker, so one file serves all three.

# Required. PostgreSQL connection string, ending ?schema=public
#   Neon: run `npm run db:url` in the source checkout to print it.
#   It must start with postgresql:// — not https://, and not a
#   *.vercel.app domain. Strip any surrounding quotes.
#
# The Worker itself reaches the database through Hyperdrive, whose binding
# carries the pooled connection string. This one is for the migrations, which
# Hyperdrive cannot run, and for a local run.
#
# A managed database scales to zero, so the first connection has to wake it.
# Prisma's default of five seconds is often not enough, and the first
# request after an idle period fails while the ones after it succeed:
#   ...?sslmode=require&connect_timeout=15&pool_timeout=10
DATABASE_URL=""

# Optional. The direct, unpooled connection to the same database, used for
# the migrations: a migration wants a connection of its own, because it holds
# a Postgres advisory lock and the pooled endpoint shares its sessions.
DIRECT_DATABASE_URL=""

# Required. Generate each with: openssl rand -base64 32
JWT_SECRET=""
REFRESH_SECRET=""

# The captcha's site key is inlined into the web bundle by Vite, and the
# bundle is built by `npm run web:build`. On the Worker it is a secret:
#   npx wrangler secret put NEXT_PUBLIC_TURNSTILE_SITE_KEY
#
# Object storage - Vercel Blob.
#
# The token identifies the store, so it is all the code needs. Create the
# store in the Vercel project (Storage -> Blob) and copy its token:
#   BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"
#   BLOB_STORE_ID="store_…"
#
# Without it the uploads fall back to a local disk, which a serverless host
# discards between requests.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# Object storage - any S3-compatible store, such as Neon Object Storage.
#
# These are only read when BLOB_READ_WRITE_TOKEN is not set, so a deployment
# that uses Blob can leave them alone.
#   AWS_ENDPOINT_URL_S3="https://<branch>.storage.c-<cell>.<region>.aws.neon.tech"
#   AWS_ACCESS_KEY_ID=""
#   AWS_SECRET_ACCESS_KEY=""
#   AWS_REGION="ap-southeast-1"
#   NEON_STORAGE_BUCKET="eventinvites-storage"
# The bucket's access level is a property of the bucket, not of the request,
# so it is stated here rather than probed: a public bucket answers the browser
# itself, a private one is read with these credentials and served by the API.
#   NEON_STORAGE_ACCESS="private"
#
# STORAGE_BACKEND picks the store when more than one is configured; without it
# the first configured store wins (Vercel Blob, then an S3-compatible store,
# then a local disk).
#   STORAGE_BACKEND="blob"
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
NEON_STORAGE_BUCKET=""
NEON_STORAGE_ACCESS=""

# Required. The Cloudflare Turnstile key pair, from the Cloudflare
# dashboard -> Turnstile -> Add site. The SECRET stays server-side; the
# SITE key is inlined into the browser bundle — by Next.js for the pages, and
# by Vite for the web app and the APK, which read VITE_TURNSTILE_SITE_KEY.
#   Secret: https://dash.cloudflare.com -> Turnstile -> <site> -> Secret Key
#   Site:   https://dash.cloudflare.com -> Turnstile -> <site> -> Site Key
# A challenge is asked for when signing in or registering, when an event is
# created or deleted, and when feedback is sent through the form.
# Without the secret the API accepts every challenge, so the check is only
# real where it is set. The app's own arithmetic challenge is used only when
# the widget cannot be shown — its script is blocked, or the hostname is not
# on the widget's list in the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
VITE_TURNSTILE_SITE_KEY=""
# Optional. Signs the fallback challenge's tokens; defaults to JWT_SECRET.
CAPTCHA_SECRET=""

# FRONTEND_URL — comma-separated origins allowed to call the API. Include
# the APK's WebView origin (https://localhost) so the Bearer-header preflight
# is accepted: e.g. https://your-app.vercel.app,https://localhost
# Leave unset only if the API and frontend share an origin and there is no APK.
FRONTEND_URL=""

# Push notifications for the Android app.
#
# The service-account key from Firebase -> Project settings -> Service
# accounts -> Generate new private key, as the raw JSON or its base64 copy.
# Leave it unset and nothing is pushed: the web app and the API behave exactly
# as they do today. Set it (on the API's environment, not the frontend's) and
# every notification written by the app is also delivered to the signed-in
# user's registered devices.
#   FCM_SERVICE_ACCOUNT_JSON=""
# Optional, only when the key belongs to more than one Firebase project:
#   FCM_PROJECT_ID=""

# Not Vercel variables: read at APK build/sync time.
#
# CAPACITOR_DEV=1           — set this to make the shell load a dev server
#                            (default: off, so the release build loads mobile/www/)
# CAPACITOR_SERVER_URL      — the dev server URL when CAPACITOR_DEV=1
#                            (default: http://10.0.2.2:5173)
# VITE_API_BASE             — the absolute API URL baked into the Vite bundle,
#                            e.g. https://your-app.vercel.app/api. Required
#                            for `npm run app:build` to produce a working APK.
#   CAPACITOR_DEV=1
#   CAPACITOR_SERVER_URL=http://10.0.2.2:5173
#   VITE_API_BASE=https://your-app.vercel.app/api